# PostgreSQL (docker compose up -d)
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/investment_portfolio?schema=public"

# JWT secret (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-secret-with-at-least-32-chars"

# brapi.dev token (free plan): https://brapi.dev/dashboard
BRAPI_TOKEN=""

# Public app URL (used in password reset links)
APP_URL="http://localhost:3000"
